# App URL used to bind confirmation redirects to the trusted deployment origin.
APP_BASE_URL=http://localhost:3000

# Supabase project settings. Keep the service role key server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Only listed addresses can create accounts. The initial tester can also be
# listed here; their verified account is assigned the tester role server-side.
SIGNUP_ALLOWED_EMAILS=test123@org.com
INITIAL_TESTER_EMAIL=test123@org.com

# Server-side AI provider key used when a tester does not supply a BYOK key.
LOVABLE_API_KEY=
